{
  "buildCommand": "node scripts/build-maintenance.mjs",
  "outputDirectory": "maintenance-dist",
  "routes": [
    { "src": "/(.*)", "dest": "/maintenance.html", "status": 503,
      "headers": { "Cache-Control": "no-store", "Retry-After": "3600", "X-Robots-Tag": "noindex", "X-Content-Type-Options": "nosniff" } }
  ]
}
